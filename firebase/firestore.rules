rules_version = '2';

// Reglas de seguridad de AquaControl (Sprints 5, 6 y 8).
// Principio: cada usuario solo accede a sus propios datos (mínimo privilegio)
// y la app no es frontera de confianza: aquí se valida el formato de lo que escribe.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasConsent(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.notificationsEnabled == true;
    }

    // Vinculación con el ESP32 (token del dispositivo)
    match /devices/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 32;
    }

    match /users/{uid} {
      // Preferencias y consentimiento de notificaciones
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['notificationsEnabled', 'consentAt', 'updatedAt'])
        && request.resource.data.notificationsEnabled is bool;
      allow delete: if isOwner(uid);

      // Cada zona de riego (solo existen la 1 y la 2): su nombre (Sprint 5), su
      // riego inteligente (Sprint 6) y su caudal en L/min para estimar el
      // consumo (Sprint 8). El umbral usa el mismo rango que la app y el
      // firmware: 10% a 90%; el caudal, de 1 a 30 L/min.
      match /zones/{zoneId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && zoneId in ['1', '2']
          && request.resource.data.keys().hasOnly(['name', 'updatedAt', 'smartEnabled', 'threshold', 'flowLpm'])
          && (!('name' in request.resource.data)
              || (request.resource.data.name is string
                  && request.resource.data.name.size() > 0
                  && request.resource.data.name.size() <= 30))
          && (!('smartEnabled' in request.resource.data)
              || request.resource.data.smartEnabled is bool)
          && (!('threshold' in request.resource.data)
              || (request.resource.data.threshold is int
                  && request.resource.data.threshold >= 10
                  && request.resource.data.threshold <= 90))
          && (!('flowLpm' in request.resource.data)
              || (request.resource.data.flowLpm is number
                  && request.resource.data.flowLpm >= 1
                  && request.resource.data.flowLpm <= 30));
      }

      // Tokens FCM: solo con consentimiento previo del usuario
      match /fcmTokens/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasConsent(uid)
          && request.resource.data.keys().hasOnly(['platform', 'createdAt'])
          && request.resource.data.platform in ['android', 'ios'];
      }

      // Historial de riegos y resúmenes diarios (Sprint 8): solo los escribe la
      // Cloud Function deviceHistory (Admin SDK). El dueño los lee; no puede
      // crearlos ni alterarlos, así que nadie falsea su consumo. Los registros
      // caducan a los 12 meses con la política TTL del campo expireAt.
      match /history/{recordId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /dailyStats/{date} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Avisos de riego: solo los escribe la Cloud Function (Admin SDK)
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }
    }
  }
}
