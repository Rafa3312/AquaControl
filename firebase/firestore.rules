rules_version = '2';

// Reglas de seguridad de AquaControl (Sprint 5).
// Principio: cada usuario solo accede a sus propios datos (mínimo privilegio)
// y la app no es frontera de confianza: aquí se valida el formato de lo que escribe.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasConsent(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.notificationsEnabled == true;
    }

    // Vinculación con el ESP32 (token del dispositivo)
    match /devices/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 32;
    }

    match /users/{uid} {
      // Preferencias y consentimiento de notificaciones
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['notificationsEnabled', 'consentAt', 'updatedAt'])
        && request.resource.data.notificationsEnabled is bool;
      allow delete: if isOwner(uid);

      // Nombre de cada zona de riego: solo existen las zonas 1 y 2
      match /zones/{zoneId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && zoneId in ['1', '2']
          && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30;
      }

      // Tokens FCM: solo con consentimiento previo del usuario
      match /fcmTokens/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasConsent(uid)
          && request.resource.data.keys().hasOnly(['platform', 'createdAt'])
          && request.resource.data.platform in ['android', 'ios'];
      }

      // Avisos de riego: solo los escribe la Cloud Function (Admin SDK)
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }
    }
  }
}
